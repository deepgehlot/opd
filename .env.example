# Required: Atlas connection string with credentials for your demo database.
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=opd_brief
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4.1
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
DEMO_MODE=true
DEMO_OTP=123456
# Only used when initially creating the demo accounts.
STAFF_DEMO_PASSWORD=Staff@123
DOCTOR_DEMO_PASSWORD=Doctor@123
# Local run only; Vercel supplies its own runtime.
HOST=127.0.0.1
PORT=3000
